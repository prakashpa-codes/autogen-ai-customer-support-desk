# Copy this file to .env and fill in your values. Never commit .env.

# --- Required -------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key-here

# Support dashboard sign-in. Generate both values with:  python scripts/hash_password.py
DESK_USERNAME=support
DESK_PASSWORD_HASH=
SECRET_KEY=

# --- Models ---------------------------------------------------------------
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Optional fallback chat model, used only when OpenAI is unavailable (key: aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Resolution policy -----------------------------------------------------
# Replies scoring below this confidence are escalated to a human.
CONFIDENCE_THRESHOLD=0.70
# Minimum cosine similarity for a passage to count as relevant evidence.
MIN_RELEVANCE=0.40
TOP_K=5
# round_robin: fixed order Query -> Knowledge -> Resolution -> Log
# selector:    same order, but after the Resolution Agent the model may send the ticket
#              back to the Knowledge Agent once when the evidence was weak
TEAM_MODE=round_robin

# --- Service ----------------------------------------------------------------
APP_ENV=development
MAX_CONCURRENT_TICKETS=2
PUBLIC_RATE_LIMIT_PER_MINUTE=6

# --- Gmail channel (optional, through the Gmail MCP server) -----------------------
# 1. Put the Desktop-app OAuth client JSON in secrets/gmail_credentials.json
# 2. Run: python scripts/gmail_auth.py   (one-time browser sign-in, saves secrets/gmail_token.json)
# 3. Set GMAIL_ENABLED=true and restart the backend.
GMAIL_ENABLED=false
GMAIL_POLL_SECONDS=60

# --- Docker / VPS (read by docker compose) -------------------------------------
PUBLIC_HOST=dadasports.labspace.tech
SHOP_PORT=8090
DESK_PORT=8591
